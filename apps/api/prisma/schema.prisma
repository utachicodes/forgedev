generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ProjectType {
  WEB
  MOBILE
  AI_ML
  DATA_ENG
  DEVOPS
  TESTING
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  fullName      String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   WorkspaceMember[]
  projects      Project[]         @relation("ProjectOwner")
  activities    ActivityLog[]
  
  role          Role      @default(VIEWER) // Global role: OWNER, ADMIN, EDITOR, VIEWER (mapped from existing enum, but making it explicit on User)
  status        UserStatus @default(PENDING) // New field for access request
  
  // Password reset
  resetToken        String?   
  resetTokenExpiry  DateTime?
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  members     WorkspaceMember[]
  projects    Project[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        Role      @default(VIEWER)
  joinedAt    DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

model Project {
  id          String      @id @default(uuid())
  name        String
  description String?
  type        ProjectType
  workspaceId String
  ownerId     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  owner       User        @relation("ProjectOwner", fields: [ownerId], references: [id])
  
  // AI/ML Specific
  datasets    Dataset[]
  models      Model[]
  experiments Experiment[]
  trainingJobs TrainingJob[]

  // DevOps Specific
  pipelines   Pipeline[]
  deployments Deployment[]
}

// --- AI/ML Module ---

enum DatasetType {
  IMAGE
  TEXT
  TABULAR
  VIDEO
  AUDIO
}

enum DatasetFormat {
  CSV
  JSON
  IMAGES_ZIP
  VIDEO_ZIP
  PARQUET
  TFRECORDS
}

enum ModelType {
  CLASSIFICATION
  DETECTION
  SEGMENTATION
  REGRESSION
  CLUSTERING
  GENERATION
  NLP
}

enum Framework {
  PYTORCH
  TENSORFLOW
  SCIKIT_LEARN
  HUGGINGFACE
  KERAS
}

enum TrainingStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  STOPPED
}

model Dataset {
  id              String        @id @default(uuid())
  projectId       String
  name            String
  description     String?
  type            DatasetType
  format          DatasetFormat
  storagePath     String        // S3/local path
  sizeBytes       BigInt
  numSamples      Int?
  preprocessConfig Json?        // Preprocessing pipeline config
  splits          Json?         // {train: 0.7, val: 0.15, test: 0.15}
  metadata        Json?         // Custom metadata (class distribution, etc.)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project         Project       @relation(fields: [projectId], references: [id])
  models          Model[]
  trainingJobs    TrainingJob[]
}

model Model {
  id              String        @id @default(uuid())
  projectId       String
  datasetId       String?
  name            String
  description     String?
  version         String
  framework       Framework
  modelType       ModelType
  status          TrainingStatus
  
  // Training configuration
  hyperparameters Json?         // {lr, batch_size, epochs, optimizer, etc.}
  architecture    String?       // ResNet50, YOLO, custom, etc.
  
  // Results
  metrics         Json?         // {accuracy, loss, f1, mAP, etc.}
  trainDuration   Int?          // seconds
  
  // Storage
  artifactUrl     String?       // Model weights/checkpoint URL
  exportedFormats Json?         // {onnx: "url", torchscript: "url"}
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project         Project       @relation(fields: [projectId], references: [id])
  dataset         Dataset?      @relation(fields: [datasetId], references: [id])
  checkpoints     ModelCheckpoint[]
  trainingJob     TrainingJob?
}

model ModelCheckpoint {
  id          String    @id @default(uuid())
  modelId     String
  epoch       Int
  metrics     Json      // Metrics at this checkpoint
  checkpointUrl String  // Storage URL
  createdAt   DateTime  @default(now())

  model       Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model TrainingJob {
  id              String        @id @default(uuid())
  projectId       String
  modelId         String        @unique
  datasetId       String
  
  framework       Framework
  status          TrainingStatus @default(QUEUED)
  
  // Configuration
  config          Json          // Complete training config
  gpuEnabled      Boolean       @default(false)
  
  // Progress tracking
  currentEpoch    Int           @default(0)
  totalEpochs     Int
  progress        Float         @default(0) // 0-100
  
  // Metrics
  liveMetrics     Json?         // Latest metrics
  metricsHistory  Json?         // Full history [{epoch, loss, acc}, ...]
  
  // Logs
  logsUrl         String?       // Storage URL for full logs
  lastLogLines    String?       // Last 100 lines for quick view
  
  // Resource usage
  cpuUsage        Float?
  memoryUsage     Float?
  gpuUsage        Float?
  
  // Timing
  startedAt       DateTime?
  endedAt         DateTime?
  estimatedEta    DateTime?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project         Project       @relation(fields: [projectId], references: [id])
  model           Model         @relation(fields: [modelId], references: [id])
  dataset         Dataset       @relation(fields: [datasetId], references: [id])
}

model Experiment {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  description String?
  framework   Framework
  params      Json      // Hyperparameters tried
  metrics     Json?     // Results
  status      TrainingStatus
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  project     Project   @relation(fields: [projectId], references: [id])
}

// --- DevOps Module ---

model Pipeline {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  config      Json      // The pipeline definition (YAML/JSON)
  lastRunStatus String?

  project     Project   @relation(fields: [projectId], references: [id])
}

model Deployment {
  id          String    @id @default(uuid())
  projectId   String
  environment String    // production, staging
  status      String
  url         String?
  deployedAt  DateTime  @default(now())

  project     Project   @relation(fields: [projectId], references: [id])
}

model ActivityLog {
  id          String    @id @default(uuid())
  userId      String
  action      String
  metadata    Json?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
}
